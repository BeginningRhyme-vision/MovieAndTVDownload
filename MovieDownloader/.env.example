# 敏感配置模板：复制本文件为 .env 并填入真实值。
# .env 已被 .gitignore 忽略，不会提交到 git。
# 各脚本启动时会自动加载同目录 .env（不覆盖已存在的环境变量），
# 敏感项一律「环境变量优先，config.yaml 留空回退」。

# ---- R2 上传凭据（download_movies.py）----
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET=your-bucket-name
R2_ACCESS_KEY=your-access-key-id
R2_SECRET_KEY=your-secret-access-key

# ---- TMDB API Key（fetch_movie_metadata.py）----
TMDB_API_KEY=your-tmdb-api-key

# ---- 住宅代理凭据（tmdb_ids_to_links.py）----
PROXY_USER=your-proxy-user
PROXY_PASSWORD=your-proxy-password

# ---- SubDL 字幕 API Key（fetch_subtitles.py）----
# 在 https://subdl.com/panel/api 免费申请后填入
SUBDL_API_KEY=
